{
  "schema_version": 1,
  "project": {
    "name": "QED Colony",
    "repo_url": "https://github.com/RSoulatIOHK/qed-colony",
    "mission": "An autonomous research colony building a local Lean tactic with kernel-checked proofs."
  },
  "database": ".colony/colony.db",
  "seed_file": "tasks/initial.json",
  "observatory_dir": "observatory/dist",
  "workers": {
    "max_concurrency": 4,
    "max_tasks_per_invocation": 1,
    "timeout_seconds": 180,
    "max_timeout_seconds": 180,
    "lease_seconds": 300,
    "sandbox": "read-only",
    "allowed_sandboxes": [
      "read-only"
    ],
    "automatic_merge": false,
    "automatic_publication": false
  },
  "autonomy": {
    "enabled": true,
    "repository": "RSoulatIOHK/qed-colony",
    "base_branch": "main",
    "max_daily_seconds": 3600,
    "max_daily_attempts": 18,
    "timezone": "Europe/Paris",
    "max_concurrency": 1,
    "poll_seconds": 15,
    "author_timeout_seconds": 480,
    "review_timeout_seconds": 240,
    "planner_timeout_seconds": 180,
    "max_revisions": 2,
    "allow_implementation": true,
    "automatic_publication": true,
    "automatic_merge": true,
    "required_checks": [
      "control-plane",
      "lean-seed"
    ],
    "model_tiers": [
      {
        "model": "gpt-6-luna",
        "reasoning_effort": "medium"
      },
      {
        "model": "gpt-6-sol",
        "reasoning_effort": "high"
      },
      {
        "model": "gpt-6.1-sol",
        "reasoning_effort": "high"
      }
    ],
    "operations_audit_every_cycles": 3,
    "operations_max_backlog": 12
  }
}
